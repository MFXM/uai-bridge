# ---------------------------------------------------------------------------
# u:ai bridge configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- u:ai API credentials (from the ZID; your personal API client) ---------
UAI_CLIENT_ID=
UAI_CLIENT_SECRET=
# UAI_BASE_URL=https://univie-api.academic-ai.at

# --- Who may use the bridge ------------------------------------------------
# One or more comma-separated keys (>= 24 chars). Clients send
#   Authorization: Bearer <key>     (OpenAI SDKs: api_key=<key>)
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_API_KEYS=

# static      = the bridge uses the credentials above for everyone (default)
# passthrough = each caller sends their OWN u:ai credentials as
#               Authorization: Bearer <CLIENT_ID>:<CLIENT_SECRET>   (needs HTTPS in front!)
# BRIDGE_CREDENTIAL_MODE=static

# Optional: networks that may call without a key, e.g. an internal Docker network.
# Only safe if the bridge port is NOT published (see README, "Adding the bridge to an existing Docker Compose stack").
# BRIDGE_TRUSTED_CIDRS=
# Disable auth completely (only if nothing but you can reach the port). Not recommended.
# BRIDGE_ALLOW_NO_AUTH=false

# --- Network ---------------------------------------------------------------
# Outside Docker the default is 127.0.0.1 (local only). The Docker image sets 0.0.0.0
# inside the container; restrict exposure with the compose port mapping instead.
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8000

# --- Features --------------------------------------------------------------
# Knowledge-base / Tailored-AI management endpoints under /v1/uai/* (default off)
# BRIDGE_ENABLE_KB=false
# Swagger UI at /docs (default off)
# BRIDGE_ENABLE_DOCS=false
# placeholder = replace images by a text note (default); forward = send image_url parts
# (image input is not documented by the u:ai API - test before relying on it)
# BRIDGE_IMAGE_MODE=placeholder
# Append "**Sources:**" from Tailored-AI citations to the answer text
# BRIDGE_APPEND_CITATIONS=true
# BRIDGE_DEFAULT_MODEL=gpt-4o
# Base model used for "tailored:<id>" if no "@model" suffix is given
# BRIDGE_TAILORED_BASE_MODEL=gpt-4o

# --- Limits ----------------------------------------------------------------
# BRIDGE_UPSTREAM_TIMEOUT_S=300
# Retries for connection errors and HTTP 429/502/503/504 (never for timeouts)
# BRIDGE_MAX_RETRIES=2
# BRIDGE_MAX_CONCURRENCY=8
# Client-side limit, keep below your API client's rate limit (0 = off)
# BRIDGE_RATE_LIMIT_RPM=90
# BRIDGE_MAX_REQUEST_MB=10
# u:ai rejects files > 50 MB
# BRIDGE_MAX_UPLOAD_MB=50
# BRIDGE_UPLOAD_EXTENSIONS=pdf,doc,docx,txt,md,csv,html,htm,rtf,odt,pptx,xlsx,json
# BRIDGE_INGEST_TIMEOUT_S=600
# BRIDGE_INGEST_POLL_S=5
# BRIDGE_MODELS_CACHE_S=300
# BRIDGE_LOG_LEVEL=INFO
